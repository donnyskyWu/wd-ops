# 生产 ops-server 外部叠加模板 — 复制为 ops-server-prod.yaml 并填入真实口令
# DO NOT commit ops-server-prod.yaml (gitignored).
# 用法：
#   java -jar football-module-ops-server.jar \
#     --spring.profiles.active=prod \
#     --spring.config.additional-location=file:/opt/ops/config/ops-server-prod.yaml
# 全部 literal 值，无 ${...} 占位符；结构与 JAR 内 application-prod.yaml 一致

--- #################### 注册中心 + 配置中心 ####################

spring:
  cloud:
    nacos:
      server-addr: 110.42.49.224:8848
      username: nacos
      password: xxx
      discovery:
        namespace: prod
        group: DEFAULT_GROUP
        register-enabled: true
        fail-fast: false
        failure-tolerance-enabled: true
        metadata:
          version: prod-ops-v189
      config:
        enabled: false
        namespace: prod
        group: DEFAULT_GROUP
    openfeign:
      client:
        config:
          default:
            connectTimeout: 10000
            readTimeout: 120000

--- #################### 数据库 + Redis + Flyway ####################

spring:
  flyway:
    enabled: true
  datasource:
    druid:
      web-stat-filter:
        enabled: true
      stat-view-servlet:
        enabled: true
        allow:
        url-pattern: /druid/*
        login-username:
        login-password:
      filter:
        stat:
          enabled: true
          log-slow-sql: true
          slow-sql-millis: 100
          merge-sql: true
        wall:
          config:
            multi-statement-allow: true
    dynamic:
      primary: master
      strict: true
      druid:
        initial-size: 2
        min-idle: 2
        max-active: 30
        max-wait: 60000
        time-between-eviction-runs-millis: 60000
        min-evictable-idle-time-millis: 600000
        max-evictable-idle-time-millis: 1800000
        validation-query: SELECT 1 FROM DUAL
        test-while-idle: true
        test-on-borrow: false
        test-on-return: false
        pool-prepared-statements: true
        max-pool-prepared-statement-per-connection-size: 20
      datasource:
        master:
          url: jdbc:mysql://110.42.49.224:3306/shenyu-ops?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false&rewriteBatchedStatements=true
          username: shenyu-ops
          password: xxx
          driver-class-name: com.mysql.cj.jdbc.Driver
  data:
    redis:
      host: 110.42.49.224
      port: 6379
      database: 1
      password: xxx

--- #################### 定时任务 + 分布式锁 ####################

xxl:
  job:
    enabled: true
    accessToken: xxx
    admin:
      addresses: http://127.0.0.1:9090/xxl-job-admin
    executor:
      appname: football-ops-executor
      ip:
      port: -1
      logpath: /opt/ops/logs/xxl-job/ops-server
      logretentiondays: 30

lock4j:
  acquire-timeout: 3000
  expire: 30000

--- #################### 监控端点 ####################

management:
  endpoints:
    web:
      base-path: /actuator
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: when_authorized

--- #################### Ops / Football 业务 ####################

football:
  web:
    admin-ui:
      url: https://beta.h5.shenyu.com
  ai:
    scheme-generate-url: http://ai.author.shenyu.com/api/v1/tasks
    scheme-generate-api-key: pi-sk-9d49187d2ac7e2ad4b796fad
    scheme-get-url: http://ai.author.shenyu.com/api/v1/tasks
    model: deepseek-v4-flash
    poll-timeout-ms: 600000

oa:
  auth:
    gateway-login-user:
      enabled: true
    dev-token:
      enabled: false
    legacy-ds-token:
      enabled: false
    football-redis:
      enabled: true
      host: 110.42.49.224
      port: 6379
      database: 1
      password: xxx
  crypto:
    aes-key: xxx
  file:
    upload-dir: /opt/ops/data/uploads
    max-file-size: 52428800
  notification:
    platform-base-url: https://beta.h5.shenyu.com/ops
  match:
    internal-base-url: http://127.0.0.1:48088
  unified-collector:
    base-url: http://ai.shenyu.com/
    api-token: bce3aa7b4922977ccb88063f2ee8ec137c1f5bff44890ba8cf5e35511cbfe434
    timeout-ms: 30000
    stub: false
  collect:
    schedule:
      enabled: true
      scan-cron: "0 * * * * ?"
    stub:
      force-fail: false
  work-task:
    win-prediction:
      enabled: true
      match-end-buffer-minutes: 120
      scheduled-fallback-enabled: false
      scheduled-cron: "0 0 * * * ?"

--- #################### 日志 ####################

logging:
  level:
    root: INFO
    football.module.ops: INFO
  file:
    name: /opt/ops/logs/ops-server.log
