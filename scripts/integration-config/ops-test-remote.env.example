# See docs/delivery/OPS-TEST-DB.md

# ---- MySQL host ----
OPS_TEST_DB_HOST=110.42.49.224
OPS_TEST_DB_PORT=3306

# ---- OPS master (was wd) ----
OPS_TEST_MASTER_DB=shenyu-ops
OPS_TEST_MASTER_USER=shenyu-ops
